// Schema CRM Minerva Consultores — Propuesta 102
// Cubre RF-001 a RF-130. Fase 1.
//
// Convenciones:
// - Montos y porcentajes en Decimal (nunca Float) para evitar errores de redondeo en cotizaciones.
// - Los estados de dominio fijo usan enum. Lo que RF pide "configurable" usa tabla propia.
// - Las FKs se replican en la capa de aplicación (ver src/lib/db/tx.ts) para que el schema
//   sea portable entre MySQL, TiDB y MariaDB sin depender del motor que las haga cumplir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// RF-01 Gestión de Usuarios y Autenticación (RF-001 a RF-012)
// ---------------------------------------------------------------------------

enum IdentificationType {
  CEDULA_FISICA
  CEDULA_JURIDICA
  DIMEX
  NIT
  PASAPORTE
  OTRO
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  roleId       String    @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Sesiones
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // Ownership / auditoría
  createdClients      Client[]           @relation("ClientCreatedBy")
  ownedOpportunities  Opportunity[]      @relation("OpportunityOwner")
  assignedActivities  Activity[]         @relation("ActivityAssignee")
  createdActivities   Activity[]         @relation("ActivityCreator")
  createdQuotations   Quotation[]        @relation("QuotationCreatedBy")
  auditLogs           AuditLog[]

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId, isActive])
  @@map("users")
}

// RF-009/RF-010: los roles se administran desde la aplicación. Las casillas
// de permiso son filas de `role_permissions`; `isAdmin` marca quién puede
// administrar usuarios y roles, y se cuida que nunca quede el sistema sin
// al menos un rol administrador activo con un usuario activo.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  isAdmin     Boolean  @default(false) @map("is_admin")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@index([isSystem, isActive])
  @@map("roles")
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String @map("role_id")
  permission String @db.VarChar(60)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([permission])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// RF-012: recuperación de contraseña por token de un solo uso.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// RF-02 Gestión de Clientes (RF-013 a RF-026)
// ---------------------------------------------------------------------------

enum ClientType {
  PERSONA_FISICA
  EMPRESA
}

model Client {
  id           String @id @default(cuid())
  type         ClientType @default(EMPRESA)
  // RF-015: nombre (persona física) o razón social (empresa)
  name         String @db.VarChar(191)
  // RF-016: información de identificación
  identificationType   IdentificationType? @map("identification_type")
  identificationNumber String?            @map("identification_number") @db.VarChar(50)
  // RF-017: contacto
  phone String? @db.VarChar(30)
  email String? @db.VarChar(191)
  website String? @db.VarChar(191)
  address String? @db.VarChar(255)
  // Clasificación de la cartera: país y sector del cliente.
  country String? @db.VarChar(100)
  sector  String? @db.VarChar(150)
  // RF-018: notas
  notes String? @db.Text
  // RF-021
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdById String? @map("created_by_id")

  createdBy     User?         @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  quotations    Quotation[]

  // RF-025 / RF-123: búsqueda por nombre e identificación
  @@index([name])
  @@index([identificationNumber])
  @@index([type, isActive])
  @@index([email])
  @@index([isActive, createdAt])
  // Filtros de cartera
  @@index([sector])
  @@index([country])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// RF-03 Gestión de Contactos (RF-028 a RF-036)
// ---------------------------------------------------------------------------

model Contact {
  id         String  @id @default(cuid())
  clientId   String  @map("client_id")
  firstName  String  @map("first_name") @db.VarChar(100)
  lastName   String  @map("last_name") @db.VarChar(100)
  // RF-031: cargo o puesto
  position   String? @db.VarChar(150)
  // RF-032
  phone String? @db.VarChar(30)
  email String? @db.VarChar(191)
  // RF-033
  notes String? @db.Text
  // RF-035
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  activities    Activity[]
  quotations    Quotation[]

  // RF-036 / RF-124
  @@index([clientId, isActive])
  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive, createdAt])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// RF-04 Gestión de Productos y Servicios (RF-037 a RF-046)
// RF-089 / RF-087: moneda e impuesto. El precio se guarda en la moneda base
// del producto; la cotización fija la suya (RF-089).
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // RF-043
  products Product[]

  @@map("product_categories")
}

// RF-042: unidades de medida configurables. El producto guarda una referencia
// (unit_id); la cotización, al momento de emitirse, copia el nombre como
// snapshot en quotation_item.unit para no alterar lo ya emitido (RF-092).
model UnitOfMeasure {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive, name])
  @@map("units_of_measure")
}

model Product {
  id          String  @id @default(cuid())
  // RF-038
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(191)
  // RF-039
  description String? @db.Text
  isService   Boolean @default(false) @map("is_service")
  // RF-040: precio de venta
  price       Decimal @db.Decimal(14, 2)
  // RF-041: porcentaje de impuesto
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  currency    Currency @default(CRC)
  // RF-042: unidad de medida (catálogo configurable)
  unitId      String? @map("unit_id")
  categoryId  String? @map("category_id")
  // RF-045
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit           UnitOfMeasure?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quotationItems QuotationItem[]

  // RF-046 / RF-125
  @@index([name])
  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@map("products")
}

// ---------------------------------------------------------------------------
// RF-05 Oportunidades (RF-047 a RF-058) y RF-06 Pipeline (RF-059 a RF-065)
// ---------------------------------------------------------------------------

enum Currency {
  CRC
  USD
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// RF-059: las etapas se administran desde la app, no están fijas en código.
model Stage {
  id       String  @id @default(cuid())
  name     String  @unique @db.VarChar(100)
  position Int     @default(0)
  // RF-064: identificar ganadas y perdidas
  isWon    Boolean @default(false) @map("is_won")
  isLost   Boolean @default(false) @map("is_lost")
  // Probabilidad por defecto para la etapa; la oportunidad puede sobrescribirla.
  defaultProbability Decimal @default(0) @map("default_probability") @db.Decimal(5, 2)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  opportunities Opportunity[]

  @@index([position])
  @@map("stages")
}

model Opportunity {
  id     String @id @default(cuid())
  // RF-050
  name   String @db.VarChar(191)
  description String? @db.Text
  // RF-048
  clientId String @map("client_id")
  // RF-049
  contactId String? @map("contact_id")
  // RF-060
  stageId String @map("stage_id")
  // RF-051
  amount   Decimal  @db.Decimal(14, 2)
  currency Currency @default(CRC)
  // RF-052
  probability Decimal @default(0) @db.Decimal(5, 2)
  // RF-053
  ownerId  String  @map("owner_id")
  // RF-054
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  // RF-055
  notes String? @db.Text
  // RF-057
  status   OpportunityStatus @default(OPEN)
  closedAt DateTime?         @map("closed_at")
  lostReason String?         @map("lost_reason") @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stage       Stage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner       User          @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities  Activity[]
  quotations  Quotation[]

  // RF-062/065: filtros del pipeline, RF-126: búsqueda
  @@index([stageId, status])
  @@index([ownerId, status])
  @@index([clientId])
  @@index([status, expectedCloseDate])
  @@index([createdAt])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// RF-07 Actividades y Seguimiento (RF-066 a RF-077)
// ---------------------------------------------------------------------------

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// RF-067: "otros tipos configurables" — tabla editable desde la app.
model ActivityType {
  id        String  @id @default(cuid())
  name      String  @unique @db.VarChar(50)
  color     String  @default("#6366f1") @db.VarChar(20)
  icon      String? @db.VarChar(50)
  isActive  Boolean @default(true) @map("is_active")
  position  Int     @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  activities Activity[]

  @@index([isActive, position])
  @@map("activity_types")
}

model Activity {
  id           String   @id @default(cuid())
  // RF-067
  typeId       String   @map("type_id")
  title        String   @db.VarChar(191)
  // RF-074
  description  String?  @db.Text
  // RF-072
  scheduledAt  DateTime @map("scheduled_at")
  durationMinutes Int?  @map("duration_minutes")
  // RF-073
  priority     ActivityPriority @default(MEDIUM)
  // RF-075
  status       ActivityStatus   @default(PENDING)
  completedAt  DateTime?        @map("completed_at")
  outcome      String?          @db.Text
  // RF-071
  assigneeId   String   @map("assignee_id")
  // RF-068 / RF-069 / RF-070: cualquiera de las tres, o ninguna
  clientId       String? @map("client_id")
  contactId      String? @map("contact_id")
  opportunityId  String? @map("opportunity_id")
  createdById    String  @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type        ActivityType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  assignee    User         @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // RF-076 (pendientes) y RF-077 (historial)
  @@index([assigneeId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([clientId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([scheduledAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// RF-08 Cotizaciones (RF-078 a RF-095)
// RF-09 PDF (RF-096 a RF-103) se alimenta de Quotation + QuotationItem + CompanySetting.
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

model Quotation {
  id     String @id @default(cuid())
  // RF-079: número único. Correlativo por año, generado en el servidor.
  number String @unique @db.VarChar(30)
  // RF-080 / RF-081 / RF-082
  clientId      String @map("client_id")
  contactId     String? @map("contact_id")
  opportunityId String? @map("opportunity_id")
  // RF-089
  currency Currency @default(CRC)
  exchangeRateToBase Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(14, 6)
  // Totales desnormalizados: son el snapshot que se imprime en el PDF y lo que
  // consumen los reportes. Se recalculan en la misma transacción que los items.
  // RF-085 subtotales, RF-086 descuentos, RF-087 impuestos, RF-088 total
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  discountType   DiscountType @default(NONE) @map("discount_type")
  discountValue  Decimal      @default(0) @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)
  // RF-090
  termsAndConditions String? @map("terms_and_conditions") @db.Text
  // RF-091
  validUntil DateTime? @map("valid_until") @db.Date
  // RF-093
  status   QuotationStatus @default(DRAFT)
  // RF-092: mientras sea DRAFT es editable
  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  rejectedAt DateTime? @map("rejected_at")
  notes      String?   @db.Text
  createdById String   @map("created_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       QuotationItem[]

  // RF-095 historial, RF-127 búsqueda
  @@index([clientId])
  @@index([opportunityId])
  @@index([status, validUntil])
  @@index([createdById, createdAt])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String  @map("quotation_id")
  productId   String? @map("product_id")
  position    Int     @default(0)
  // Copia del producto al momento de cotizar: si el precio del producto cambia
  // después, la cotización ya emitida no debe alterarse (RF-092).
  description String  @db.VarChar(500)
  unit        String  @default("UNIDAD") @db.VarChar(30)
  // RF-084
  quantity    Decimal @default(1) @db.Decimal(14, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  // Derivados, recalculados en la transacción de guardado.
  lineSubtotal Decimal @default(0) @map("line_subtotal") @db.Decimal(14, 2)
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @map("line_tax") @db.Decimal(14, 2)
  lineTotal    Decimal @default(0) @map("line_total") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId, position])
  @@map("quotation_items")
}

// ---------------------------------------------------------------------------
// RF-09 PDF: datos de la empresa que imprime la cotización (RF-097, RF-101).
// Singleton: una fila, id fijo, para no complicar el lookup.
// ---------------------------------------------------------------------------

model CompanySetting {
  id        String  @id @default("singleton")
  name      String  @db.VarChar(191)
  legalName String? @map("legal_name") @db.VarChar(191)
  taxId     String? @map("tax_id") @db.VarChar(50)
  address   String? @db.VarChar(255)
  phone     String? @db.VarChar(30)
  email     String? @db.VarChar(191)
  website   String? @db.VarChar(191)
  logoUrl   String? @map("logo_url") @db.VarChar(500)
  defaultTermsAndConditions String? @map("default_terms_and_conditions") @db.Text
  defaultCurrency Currency @default(CRC)
  defaultTaxRate   Decimal  @default(13) @map("default_tax_rate") @db.Decimal(5, 2)
  quotationPrefix   String   @default("COT") @map("quotation_prefix") @db.VarChar(10)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Auditoría. Resuelve "consultar el historial" de RF-022, RF-036, RF-058, RF-095
// registrando quién cambió qué, no solo el estado actual del registro.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(40)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(40)
  summary    String?  @db.VarChar(500)
  changes    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
